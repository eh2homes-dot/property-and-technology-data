{
  // Cloudflare deploy settings for the directory.
  "name": "property-and-technology-data",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  // Files in public/ (styles, logo) are served directly. Every other address
  // is handled by src/worker.js.
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "SUPABASE_URL": "https://mbdffbolmbgypevlrkvz.supabase.co",
    // Publishable key: meant to be public. The database only lets it read the
    // free fields; leaders, contacts and exact unit counts are closed to it.
    "SUPABASE_KEY": "sb_publishable_0UTqrGi92MCLVxh9N85LFg_AmQ5CKUq",
    "HUB_URL": "https://property-and-technology-hub.eh2homes.workers.dev",
    // The "Report incorrect info" Google Form, as a pre-filled link. It ends in
    // "=" so each company page can add its own name to the Company question
    // (entry.1349695603 is that question's ID in the form).
    "REPORT_FORM_URL": "https://docs.google.com/forms/d/e/1FAIpQLSfXeQcIydOk8UasrF7mEozlkO2GylRZzQXT6b6IyuLbmwUTTg/viewform?usp=pp_url&entry.1349695603=",
    // Cloudflare Web Analytics site token. Empty means no visitor tracking.
    "ANALYTICS_TOKEN": ""
  }
}
